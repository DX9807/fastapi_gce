[Unit]
Description=Lightweight FastAPI application
After=network.target

[Service]
User=fastapi
Group=fastapi
WorkingDirectory=/opt/fastapi-gce
ExecStart=/opt/fastapi-gce/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
